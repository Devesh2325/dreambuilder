# Copy to .env (ignored by git) and fill in. See docs/SUPABASE_SETUP.md.
# With no values, `npm run dev` runs in demo mode, saving only in your browser.

# From Supabase: Project Settings > API.
# The anon key is safe in the browser because row-level security protects the data.
# Never put the service role key in this file: every VITE_ variable ships to browsers.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Set to "local" to force demo mode even when Supabase is configured.
# VITE_BACKEND="local"
