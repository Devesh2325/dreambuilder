# FlowPilot Environment Configuration

# App
VITE_APP_NAME="FlowPilot"
VITE_APP_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:5173/api"

# Supabase Integration (Optional for local development mode)
# When provided, FlowPilot switches to cloud Supabase Auth, DB & Storage.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# AI Provider Configuration (Optional for cloud AI mode)
# When unset, FlowPilot uses the built-in Intelligent Structural Generation Engine (Local Dev Mode)
VITE_AI_PROVIDER="mock" # "google-gemini" | "openai" | "mock"
VITE_AI_MODEL="gemini-1.5-pro"
VITE_AI_API_KEY=""

# Embed Runtime Configuration
VITE_RUNTIME_HOST="http://localhost:5173"
